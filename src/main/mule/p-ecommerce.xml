	<flow name="Checkout_Flow" doc:id="c2dee924-16f0-450b-a4a1-e2163aa977b7" maxConcurrency="1">
		<scheduler doc:name="Scheduler" doc:id="ae0fbb3c-8959-43f5-8e38-c6e854d5d3df" >
			<scheduling-strategy >
				<cron expression="0 0 1 ? * * *" timeZone="America/Santiago"/>
			</scheduling-strategy>
		</scheduler>
		<logger level="INFO" doc:name="INIT" doc:id="208285a1-5bff-4db0-8aef-05f192f30c02" message="INIT Checkout_Flow"/>
		<flow-ref doc:name="Shopify_Checkout_subFlow" doc:id="95dfaae4-7c17-45f7-9396-0fe004b498c4" name="Shopify_Checkout_subFlow"/>
		<!-- [STUDIO:"s-shopify /checkout"]<http:request method="GET" doc:name="s-shopify /checkout" doc:id="a520719a-a904-41cd-9dbc-ea2e23e43eba" config-ref="HTTP_Request_configuration_s-shopify" path="${s-shopify.basePath}${s-shopify.checkout.path}">
				<http:query-params><![CDATA[#[vars.queryParams&#93;&#93;&#93;></http:query-params>
			</http:request> [STUDIO] -->
		<choice doc:name="Choice" doc:id="6ab09bf6-71a6-4d40-ac46-4756032a0b1c" >
			<when expression="#[!isEmpty(payload.checkouts)]">
				<logger level="INFO" doc:name="sizeOf(payload.checkouts)" doc:id="662be88b-8a88-483f-af63-51f7bac1ecca" message='#["Retrieved " ++ sizeOf(payload.checkouts) ++ " Records"]'/>
				<ee:transform doc:name="Format Lead Req" doc:id="a5ee1748-d5f6-49c5-9aff-85391484d114">
			<ee:message>
				<ee:set-payload resource="salesforce/lead.dwl" />
			</ee:message>
		</ee:transform>
				<ee:transform doc:name="Add source" doc:id="f16abf17-e738-4cb9-9123-5d25475664b2">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"source": "Shopify",
	"data": payload
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<http:request method="POST" doc:name="s-salesforce /lead" doc:id="38084415-425a-40aa-8fea-6fc15a142615" config-ref="HTTP_Request_configuration_s-salesforce" path="${s-salesforce.basePath}${s-salesforce.lead.path}" />
				<logger level="DEBUG" doc:name="payload" doc:id="7ba2da93-a289-4ce7-bd5c-4904d049b140" message="#[%dw 2.0&#10;output application/json&#10;---&#10;payload]"/>
				<choice doc:name="Choice" doc:id="1b6b2c5a-e028-4e07-8c25-d7402cd2f163" >
					<when expression="#[sizeOf(payload filter () -&gt; ($.Status == false)) &gt; 0]">
						<logger level="INFO" doc:name="KO a Brevo" doc:id="f983b472-2a14-4e49-9949-ba2d648a4633" message="KO a Brevo"/>
						<ee:transform doc:name="dataToBrevo" doc:id="ec468bb2-92c4-4bc6-ad93-a4550f81d07d" >
							<ee:message >
							</ee:message>
							<ee:variables >
								<ee:set-variable variableName="dataToBrevo" ><![CDATA[%dw 2.0
output application/json

var emailTo = (p('ecommerce.checkout.error.emailTo') splitBy (",")) map () -> {
			    "email": $
				}

var errorList = (payload filter () -> ($.Status == false)) map () -> {
			    	"id": $.Id_Commerce__c,
	    			"mensaje": $.Error
					}

---
{
	"to": emailTo,
	"templateId": p('ecommerce.checkout.error.templateId') as Number,
	"params": {
		"proceso": p('ecommerce.checkout.error.proceso-checkout'),
		"items": errorList
	}
}]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
					</when>
					<otherwise >
						<logger level="INFO" doc:name="OK a Brevo" doc:id="8f9dd677-4ad1-49a7-955d-171ad48c16fd" message="OK a Brevo" />
						<ee:transform doc:name="dataToBrevo" doc:id="e9a41b8d-a643-4eb9-b3da-c922f1eb675a" >
							<ee:message />
							<ee:variables >
								<ee:set-variable variableName="dataToBrevo" ><![CDATA[%dw 2.0
output application/json

var emailTo = (p('ecommerce.checkout.success.emailTo') splitBy (",")) map () -> {
    "email": $
}

var successList = sizeOf(payload filter () -> ($.Status == true)) as String

---
{
	"to": emailTo,
	"templateId": p('ecommerce.checkout.success.templateId') as Number,
	"params": {
		"proceso": p('ecommerce.checkout.success.proceso-checkout'),
		"registros": successList
	}
}
]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
					</otherwise>
				</choice>
				<flow-ref doc:name="brevoSendEmail_subFlow" doc:id="274aa0e6-b1bf-44c6-bbfe-26fbbb669698" name="brevoSendEmail_subFlow" />
			</when>
			<otherwise >
				<logger level="INFO" doc:name="Logger" doc:id="42389e9c-b4e2-48ad-af67-f2e0b020eabe" message="No checkout records"/>
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="END" doc:id="87ad001a-14da-4827-95ea-89b0ee9683ad" message="END Checkout_Flow" />
	</flow>
	<flow name="Quote_Flow" doc:id="b5973ded-eac4-4952-ad94-05ca5d445a78" maxConcurrency="1">
		<scheduler doc:name="Scheduler" doc:id="b6372e65-60d1-480f-9d64-6eceec81edce" >
			<scheduling-strategy >
				<fixed-frequency frequency="30" startDelay="30" timeUnit="MINUTES"/>
			</scheduling-strategy>
		</scheduler>
		<logger level="INFO" doc:name="INIT" doc:id="5c5ee379-02f3-45d7-bc12-7563becbfe2a" message="INIT Quote_Flow" />
		<choice doc:name="Choice" doc:id="0afc4af3-d08d-47a1-b16a-009c9338777d" >
			<when expression="#[p('ecommerce.quote.shopify.order_id') != &quot;No&quot;]">
